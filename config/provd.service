[Unit]
Description=PROVE daemon (input provenance, injection policy, consent)
Documentation=file:///usr/share/doc/prove/SPEC.md
DefaultDependencies=no
After=local-fs.target systemd-journald.socket systemd-sysusers.service systemd-modules-load.service
Wants=systemd-modules-load.service
# Records must exist before a display server or a remapper can create devices.
Before=display-manager.service keyd.service sysinit.target
ConditionPathExists=/sys/kernel/btf/vmlinux

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/provd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
# Enforcement lives in pinned eBPF objects and is unaffected by restarts.

[Install]
WantedBy=sysinit.target
